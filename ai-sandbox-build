#!/bin/bash
# =============================================================================
# ai-sandbox-build - Builds container images for AI agents
#
# Standalone build script installed to ~/.local/bin/ by install.sh.
# Containerfiles and entrypoints are read from ~/.local/share/ai-sandbox/.
#
# Usage:
#   ai-sandbox-build              # builds everything
#   ai-sandbox-build base         # only the base image
#   ai-sandbox-build claude       # only claude-code (requires base)
#   ai-sandbox-build codex        # only codex (requires base)
#   ai-sandbox-build cursor       # only cursor-agent (requires base)
#   ai-sandbox-build opencode     # only opencode (requires base)
#
#   --with-prusaslicer / --without-prusaslicer (alias --no-prusaslicer) include
#   or leave out PrusaSlicer in the base image (and so in every agent image).
#   Without either flag the choice already made is kept: it is read from the
#   existing base image's ai-sandbox.prusaslicer label, and is "without" when
#   there is no image yet.
#
# Exit status: 0 on success, 3 when the base image failed to build with
# PrusaSlicer (install.sh then retries without it), 1 on any other failure.
# =============================================================================
set -euo pipefail

BUILDER="podman"
DATA_DIR="${AI_SANDBOX_DATA_DIR:-${HOME}/.local/share/ai-sandbox}"
BASE_IMAGE="registry.fedoraproject.org/fedora:44"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()  { echo -e "${GREEN}[BUILD]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERROR]${NC} $*" >&2; }

usage_line() {
    echo "Usage: ai-sandbox-build [--with-prusaslicer|--without-prusaslicer] [base|claude|codex|cursor|opencode|all]"
}

usage() {
    usage_line
    echo ""
    echo "Targets:"
    echo "  base     - Build the base image only"
    echo "  claude   - Build base + Claude Code image"
    echo "  codex    - Build base + Codex image"
    echo "  cursor   - Build base + Cursor Agent image"
    echo "  opencode - Build base + opencode image"
    echo "  all      - Build base + all agent images (default)"
    echo ""
    echo "Options:"
    echo "  --with-prusaslicer     Include PrusaSlicer (headless slicing) in the base image"
    echo "  --without-prusaslicer  Leave it out (alias: --no-prusaslicer)"
    echo "  Without either, the existing base image's choice is kept (none: without)."
    echo ""
    echo "Note: claude-vertex uses the claude image, no separate build needed."
    echo ""
    echo "Data directory: ${DATA_DIR}"
    echo "Override with AI_SANDBOX_DATA_DIR env var."
    exit 0
}

TARGET=""
WITH_PRUSASLICER=""    # empty = keep what the existing base image has

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)              usage ;;
        --with-prusaslicer)     WITH_PRUSASLICER=1 ;;
        --without-prusaslicer|--no-prusaslicer) WITH_PRUSASLICER=0 ;;
        -*)
            err "Unknown option: $1"
            usage_line
            exit 1
            ;;
        *)
            if [[ -n "$TARGET" ]]; then
                err "Only one target can be given (got '${TARGET}' and '$1')"
                exit 1
            fi
            TARGET="$1"
            ;;
    esac
    shift
done
TARGET="${TARGET:-all}"

if [[ ! -d "$DATA_DIR" ]]; then
    err "Data directory not found: ${DATA_DIR}"
    err "Run install.sh first, or set AI_SANDBOX_DATA_DIR"
    exit 1
fi

# Any arguments after the third are passed on to podman build.
build_image() {
    local name="$1"
    local dir="$2"
    local tag="$3"
    shift 3

    if [[ ! -f "${dir}/Containerfile" ]]; then
        err "Containerfile not found: ${dir}/Containerfile"
        exit 1
    fi

    log "Building ${name} -> ${tag}"
    "${BUILDER}" build \
        --format docker \
        "$@" \
        --tag "${tag}" \
        --file "${dir}/Containerfile" \
        "${dir}" || return 1
    log "${name} built successfully"
}

pull_base_image() {
    log "Pulling latest ${BASE_IMAGE}..."
    "${BUILDER}" pull "${BASE_IMAGE}"
}

# Without a flag, keep the PrusaSlicer choice recorded on the existing base
# image, so that a plain `ai-sandbox --build all` does not drop what install.sh
# put there.  No image yet means nothing to keep; an image built before the
# label existed has no PrusaSlicer, so an empty label reads as 0.
resolve_prusaslicer() {
    local image="localhost/agent-base:latest"
    local existing="" rc=0

    # `image exists` is 1 for "no such image"; anything else is podman failing,
    # which must not be read as "nothing to keep".
    "${BUILDER}" image exists "${image}" || rc=$?
    case "$rc" in
        0)
            if ! existing=$("${BUILDER}" image inspect \
                    --format '{{index .Config.Labels "ai-sandbox.prusaslicer"}}' "${image}"); then
                err "Could not read the labels of ${image}"
                exit 1
            fi
            [[ "$existing" == 1 ]] || existing=0
            ;;
        1) ;;
        *)
            err "podman image exists ${image} failed (exit ${rc})"
            exit 1
            ;;
    esac

    if [[ -n "$WITH_PRUSASLICER" ]]; then
        if [[ "$WITH_PRUSASLICER" == 1 ]]; then
            log "PrusaSlicer: included (--with-prusaslicer)"
        else
            log "PrusaSlicer: not included (--without-prusaslicer)"
        fi
    elif [[ -z "$existing" ]]; then
        WITH_PRUSASLICER=0
        log "PrusaSlicer: not included (no existing base image; --with-prusaslicer to add it)"
    elif [[ "$existing" == 1 ]]; then
        WITH_PRUSASLICER=1
        log "PrusaSlicer: included (kept from the existing image; --without-prusaslicer to drop it)"
    else
        WITH_PRUSASLICER=0
        log "PrusaSlicer: not included (kept from the existing image; --with-prusaslicer to add it)"
    fi

    # Agent images are built FROM the base, so changing it under a single
    # target leaves every other agent image on the previous base.
    if [[ -n "$existing" && "$WITH_PRUSASLICER" != "$existing" && "$TARGET" != all ]]; then
        local before="without"
        [[ "$existing" == 1 ]] && before="with"
        warn "Only '${TARGET}' is rebuilt: the other agent images keep the previous base"
        warn "(${before} PrusaSlicer) until 'ai-sandbox --build all'"
    fi
}

build_base() {
    resolve_prusaslicer
    pull_base_image
    if ! build_image "base" "${DATA_DIR}/base" "localhost/agent-base:latest" \
            --build-arg "WITH_PRUSASLICER=${WITH_PRUSASLICER}"; then
        if [[ "$WITH_PRUSASLICER" == 1 ]]; then
            err "The base image failed to build with PrusaSlicer"
            exit 3
        fi
        exit 1
    fi
}

build_claude() {
    build_image "claude-code" "${DATA_DIR}/claude-code" "localhost/agent-claude:latest"
}

build_codex() {
    build_image "codex" "${DATA_DIR}/codex" "localhost/agent-codex:latest"
}

build_cursor() {
    build_image "cursor-agent" "${DATA_DIR}/cursor-agent" "localhost/agent-cursor:latest"
}

build_opencode() {
    build_image "opencode" "${DATA_DIR}/opencode" "localhost/agent-opencode:latest"
}

case "${TARGET}" in
    base)
        build_base
        ;;
    claude)
        build_base
        build_claude
        ;;
    codex)
        build_base
        build_codex
        ;;
    cursor)
        build_base
        build_cursor
        ;;
    opencode)
        build_base
        build_opencode
        ;;
    all)
        build_base
        log "--- Base ready, building agents ---"
        build_claude
        build_codex
        build_cursor
        build_opencode
        log "=== All images built ==="
        "${BUILDER}" images | grep -E 'agent-(base|claude|codex|cursor|opencode)'
        ;;
    *)
        err "Unknown target: ${TARGET}"
        usage_line
        exit 1
        ;;
esac

DANGLING=$("${BUILDER}" images --filter dangling=true -q 2>/dev/null)
if [[ -n "$DANGLING" ]]; then
    log "Pruning dangling images..."
    echo "$DANGLING" | xargs "${BUILDER}" rmi -f 2>/dev/null || true
    log "Done"
fi
