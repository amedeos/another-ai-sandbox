# --- Configuration ------------------------------------------------------------

DEFAULT_ADDR = "127.0.0.1"
DEFAULT_PORT = 8765

HOME = Path(os.path.expanduser("~"))
TOKEN_FILE = Path(os.environ.get("AI_SANDBOX_WEB_TOKEN_FILE",
                                 HOME / ".config" / "ai-sandbox" / "web-token"))
WEB_DIR = Path(os.environ.get("AI_SANDBOX_WEB_DIR",
                              HOME / ".local" / "share" / "ai-sandbox" / "web"))
AI_SANDBOX = os.environ.get("AI_SANDBOX_BIN", str(HOME / ".local" / "bin" / "ai-sandbox"))
PODMAN = os.environ.get("AI_SANDBOX_PODMAN", "podman")

# Directories a session may be started on. A compromised agent that somehow
# reached this server must not be able to ask for a sandbox over "/".
ALLOWED_ROOTS = [Path(p).resolve() for p in
                 os.environ.get("AI_SANDBOX_WEB_ROOTS", str(HOME)).split(":") if p]

AGENTS = ("claude", "claude-vertex", "codex", "cursor", "opencode")
SESSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$")
CPUS_RE = re.compile(r"^[0-9]+(\.[0-9]+)?$")
SIZE_RE = re.compile(r"^[0-9]+[bkmg]$")
# A --block-cmd rule: a binary, a colon, and optionally the argument to match.
# The argument half may carry spaces ("git:push --force"), so rules are taken
# one per line rather than split on whitespace. Nothing here reaches a shell --
# each rule is one argv element -- but the charset stays narrow anyway, because
# this is browser input on its way to a program running under sudo.
BLOCK_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}:[A-Za-z0-9 ._+=/@:,-]{0,128}$")

LABEL_PREFIX = "ai-sandbox."
MAX_PASTE_BYTES = 10 * 1024 * 1024
MAX_BODY_BYTES = 1 * 1024 * 1024
IDLE_REAP_SECONDS = 30
HEARTBEAT_SECONDS = 15

# Only formats an agent CLI is likely to accept as an image path.
