# =============================================================================
# Cursor Agent CLI - sandboxed container
# Auth: CURSOR_API_KEY env var or cursor-agent login
# =============================================================================
FROM localhost/agent-base:latest

USER root

# Install cursor-agent as agent user, then move entire installation to /opt
# so it survives the tmpfs mount on /home/agent at runtime
USER agent
RUN curl -fsSL https://cursor.com/install | bash

USER root
# cursor-agent is a bash wrapper that expects node and index.js in the same dir
# Copy the entire versioned directory to /opt and create symlink
RUN CURSOR_VERSION_DIR=$(ls -d /home/agent/.local/share/cursor-agent/versions/*/ | head -1) \
    && cp -rL "$CURSOR_VERSION_DIR" /opt/cursor-agent \
    && chmod 755 /opt/cursor-agent/cursor-agent /opt/cursor-agent/node \
    && ln -sf /opt/cursor-agent/cursor-agent /usr/local/bin/cursor-agent

USER agent
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/cursor-agent"]
