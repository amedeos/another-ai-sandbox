# =============================================================================
# Claude Code - sandboxed container
# Native installer (npm is deprecated, Node.js no longer required at runtime)
# Auth: ANTHROPIC_API_KEY env var or OAuth via ~/.claude/
# =============================================================================
FROM localhost/agent-base:latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install as agent so the installer sets up ~/.local/bin/claude
USER agent
RUN curl -fsSL https://claude.ai/install.sh | bash

# Move entire installation to /opt so it survives the tmpfs on /home/agent
USER root
RUN cp -rL /home/agent/.local /opt/claude-local \
    && chmod -R 755 /opt/claude-local/bin \
    && ln -sf /opt/claude-local/bin/claude /usr/local/bin/claude

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

USER agent
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
