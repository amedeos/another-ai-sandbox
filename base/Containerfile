# =============================================================================
# Base image for AI agent sandboxing
# Provides common tooling: Node.js, Python, Git, curl
# =============================================================================
FROM registry.fedoraproject.org/fedora:44

LABEL maintainer="amedeo" \
      description="Base image for sandboxed AI coding agents"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Common toolchain for all agents
# Size optimisations (base Fedora ≈200 MB → final layer ≈1.2 GB):
#   --setopt=install_weak_deps=False  skip Recommends/Suggests
#   --setopt=tsflags=nodocs           skip man pages and documentation
#   rpm -e --nodeps …                 remove mupdf GUI deps (mesa/llvm/X11) unused by mutool
#   strip --strip-unneeded            remove debug symbols from ELF binaries
#   rm -rf …/doc,man,info,locale      remove residual documentation
RUN dnf install -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        nodejs \
        npm \
        git-core \
        python3 \
        python3-pip \
        python3.12 \
        python3.12-devel \
        python3.12-libs \
        python3.13 \
        python3.13-devel \
        python3.13-libs \
        curl \
        findutils \
        diffutils \
        ripgrep \
        jq \
        tar \
        gzip \
        unzip \
        wget \
        patch \
        tree \
        ansible \
        ansible-lint \
        binutils \
        file \
        less \
        which \
        procps-ng \
        fd-find \
        strace \
        yq \
        sed \
        gawk \
        grep \
        ShellCheck \
        ruff \
        python3-pytest \
        poppler-utils \
        mupdf \
        yamllint \
        pandoc \
    && rm -f /usr/bin/as /usr/bin/ld /usr/bin/ld.bfd \
    && rm -f /usr/bin/mupdf /usr/bin/mupdf-gl /usr/bin/mupdf-x11 \
    && rpm -e --nodeps \
        llvm-libs llvm-filesystem \
        mesa-dri-drivers mesa-libGL mesa-libgbm mesa-filesystem \
        hwdata \
        freeglut libglvnd libglvnd-opengl libglvnd-glx \
        libX11 libX11-common libX11-xcb libXau libXext libXi libXrender libXxf86vm \
        libxcb libxshmfence \
        2>/dev/null || true \
    && curl -fsSL https://mirror.openshift.com/pub/openshift-v4/clients/ocp/latest/openshift-client-linux.tar.gz \
        | tar xz -C /usr/local/bin oc kubectl \
    && chmod 755 /usr/local/bin/oc /usr/local/bin/kubectl \
    && dnf clean all \
    && rm -rf /var/cache/dnf /usr/share/doc /usr/share/man /usr/share/info /usr/share/locale \
    && find /usr -type f \( -name '*.so*' -o -perm /111 \) -exec strip --strip-unneeded {} + 2>/dev/null || true \
    && rm -rf /usr/lib/.build-id

# Non-root user for agent execution
RUN useradd -m -s /bin/bash agent

# Terminal multiplexer backing `ai-sandbox --web`: the agent runs inside a
# zellij session so that closing the browser or the terminal detaches instead
# of killing it.  Kept in its own layer so a version bump does not rebuild the
# package layer above (whose trailing `strip` would also invalidate the hash).
#
# The "no-web" build is deliberate: zellij ships its own web server, which this
# project does not use (see README "Web UI"), and omitting it saves ~4 MB.
# Upstream publishes a .sha256sum sidecar per asset covering the EXTRACTED
# binary rather than the tarball, so verification happens after extraction.
ARG ZELLIJ_VERSION=0.45.1
ARG ZELLIJ_SHA256_X86_64=0ec6ef07b63c6355c02ce18343d40ef5ef5af19e25313ea9009c8fceda29e94f
ARG ZELLIJ_SHA256_AARCH64=2f3965f5b4d7fbb25dfc543e91f9680c9ee7b4eb07d8a3e6392fa276fc65c509
RUN set -euo pipefail \
    && case "$(uname -m)" in \
        x86_64)  zj_arch="x86_64-unknown-linux-musl";  zj_sha="${ZELLIJ_SHA256_X86_64}" ;; \
        aarch64) zj_arch="aarch64-unknown-linux-musl"; zj_sha="${ZELLIJ_SHA256_AARCH64}" ;; \
        *) echo "unsupported architecture for zellij: $(uname -m)" >&2; exit 1 ;; \
       esac \
    && curl -fsSL --retry 3 --retry-delay 2 -o /tmp/zellij.tar.gz \
        "https://github.com/zellij-org/zellij/releases/download/v${ZELLIJ_VERSION}/zellij-no-web-${zj_arch}.tar.gz" \
    && mkdir -p /tmp/zellij-extract \
    && tar -xzf /tmp/zellij.tar.gz -C /tmp/zellij-extract \
    && zj_bin="$(find /tmp/zellij-extract -type f -name zellij | head -1)" \
    && [ -n "$zj_bin" ] \
    && echo "${zj_sha}  ${zj_bin}" | sha256sum -c - \
    && install -m 755 "$zj_bin" /usr/local/bin/zellij \
    && rm -rf /tmp/zellij.tar.gz /tmp/zellij-extract

LABEL ai-sandbox.zellij="0.45.1"

# `podman exec` inherits the container's configured environment (Config.Env),
# NOT variables exported by the entrypoint at runtime.  Anything that PID 1 and
# `podman exec ... zellij attach` must agree on therefore belongs here: pointed
# at the wrong socket directory, an exec would silently create a *second*
# session instead of attaching to the running one.
#
# The socket path has a 107-byte limit, so keep it short and on tmpfs.
# LANG matters because the package layer removes /usr/share/locale; glibc's
# built-in C.UTF-8 is the only UTF-8 locale left, and zellij's UI needs one.
ENV ZELLIJ_SOCKET_DIR=/tmp/zellij-sock \
    ZELLIJ_CONFIG_FILE=/etc/zellij/config.kdl \
    LANG=C.UTF-8

COPY zellij.kdl /etc/zellij/config.kdl
COPY ai-sandbox-supervise /usr/local/bin/ai-sandbox-supervise
RUN chmod 644 /etc/zellij/config.kdl \
    && chmod 755 /usr/local/bin/ai-sandbox-supervise

# Standard working directory
WORKDIR /workspace
